    window-rule {
        geometry-corner-radius 0 // Set every window radius to 20
        clip-to-geometry true
	      background-effect {
		      blur true
          xray false
        }
}
    blur {
	    passes 1
	    noise 0
	    offset 1.0
}



    window-rule {
      match app-id="steam"
      exclude title=r"^[Ss]team$"
      open-floating true
	    opacity 0.95
}

    window-rule {
      match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
      default-floating-position x=10 y=10 relative-to="bottom-right"
      open-focused false
}

    window-rule {
	    match title="Servers"
	    open-floating true
}

    window-rule {
	    match app-id="vesktop"
	    open-on-workspace "1-2"
	    open-focused false
	    opacity 0.95
}

    window-rule {
	    match app-id="pavucontrol"
	    open-floating true
	    default-floating-position x=10 y=10 relative-to="top-right"
	    opacity 0.95
}

    window-rule {
	    match app-id="Spotify"
	    open-on-workspace "1-2"
	    open-focused false
	    opacity 0.95
}

    window-rule {
	    match title="Krita"
	    open-on-workspace "main"
      open-focused true
      open-maximized true
	    opacity 1.0
}

    window-rule {
	    match title="Sober"
	    open-fullscreen false
	    open-on-workspace "main"
}

    window-rule {
	    match app-id="Nautilus"
	    opacity 0.95
}

    window-rule {
	    match app-id="btop"
	    opacity 0.95
}

    window-rule {
      match app-id="zen"
      open-on-workspace "main"
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
}

    window-rule {
	    match app-id="dev.noctalia.Noctalia"
	    open-floating true
	    default-column-width { fixed 1080; }
	    default-window-height { fixed 920; }
      open-focused true
    }

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
  }
}
 
